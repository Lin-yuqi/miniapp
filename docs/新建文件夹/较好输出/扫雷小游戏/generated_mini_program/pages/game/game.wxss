/* pages/game/game.wxss */
.game-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: #f5f7fb;
  padding: 20rpx;
}

/* 状态栏 */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 756rpx; /* 9*84 */
  margin-bottom: 20rpx;
  background: #e0e0e0;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.status-item {
  color: #333;
}

.mode-switch {
  background: #c0c0c0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #808080;
  cursor: pointer;
}

/* 棋盘 */
.board {
  width: 756rpx;
  height: 756rpx;
  background: #c0c0c0;
  border: 3rpx solid #808080;
  box-shadow: 0 0 0 1rpx #fff inset;
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-inner {
  display: flex;
  flex-wrap: wrap;
  width: 756rpx;
  height: 756rpx;
}

/* 格子基本样式 */
.cell {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 40rpx;
  font-weight: bold;
  border: 1rpx solid #808080;
  cursor: pointer;
}

.cell-hidden {
  background: #c0c0c0;
  border-top: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #808080;
  border-right: 3rpx solid #808080;
}

.cell-revealed {
  background: #fff;
  border: 1rpx solid #808080;
}

.cell-empty {
  /* 无额外样式 */
}

.cell-flagged {
  background: #c0c0c0;
  border-top: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #808080;
  border-right: 3rpx solid #808080;
  color: red;
}

.cell-questioned {
  background: #c0c0c0;
  border-top: 3rpx solid #fff;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #808080;
  border-right: 3rpx solid #808080;
  color: black;
}

.cell-mine {
  background: #fff;
}

.cell-wrong {
  background: #ffcccc;
}

.cell-text {
  line-height: 1;
}

/* 数字颜色 */
.color-1 { color: #0000FF; }
.color-2 { color: #008000; }
.color-3 { color: #FF0000; }
.color-4 { color: #000080; }
.color-5 { color: #800000; }
.color-6 { color: #008080; }
.color-7 { color: #000000; }
.color-8 { color: #808080; }

/* 重新开始按钮 */
.restart-btn {
  margin-top: 30rpx;
  background: #176bff;
  color: white;
  font-size: 36rpx;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  cursor: pointer;
}

/* 结束弹窗 */
.result-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-dialog {
  width: 500rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.2);
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.result-info {
  font-size: 32rpx;
  margin-bottom: 16rpx;
  color: #333;
}

.result-btn {
  margin-top: 24rpx;
  background: #176bff;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  cursor: pointer;
  display: inline-block;
}